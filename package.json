{
  "name": "@agentrq/mermaid-agentrq",
  "version": "1.0.0",
  "description": "AgentRQ extension: draws ```mermaid blocks in tasks and messages as diagrams.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "dist",
    "agentrq-extension.json",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "esbuild src/drawer.js --bundle --minify --format=esm --platform=browser --outfile=dist/drawer.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "agentrq",
    "agentrq-extension",
    "mermaid",
    "diagrams"
  ],
  "dependencies": {
    "mermaid": "^12.0.0"
  }
}
