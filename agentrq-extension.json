{
  "name": "mermaid",
  "displayName": "Mermaid Diagrams",
  "version": "1.1.0",
  "description": "Draws mermaid code blocks in tasks and messages as diagrams, with a toggle back to the text.",
  "license": "Apache-2.0",
  "engines": {
    "agentrq": ">=0.6"
  },
  "config": [
    {
      "key": "workspaces",
      "type": "string",
      "label": "Only these workspaces (comma separated; blank means all)"
    },
    {
      "key": "maxLines",
      "type": "number",
      "label": "Largest diagram to draw, in lines"
    }
  ],
  "provides": {
    "renderers": [
      "mermaid"
    ],
    "drawers": [
      {
        "format": "mermaid",
        "entry": "dist/drawer.js"
      }
    ]
  },
  "artifact": {
    "release": "v1.1.0",
    "asset": "mermaid-agentrq-1.1.0.tgz",
    "sha256": "b1562bccd8207793f94096a251d2ca98a0897edd7bf3299cb4f1bb15cb8d302c"
  }
}
